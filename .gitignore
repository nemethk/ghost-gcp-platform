# Private key, decrypted by anyone who has it — never committed.
age.agekey
# Project-local, isolated kubeconfig — for demo purpose only (infra/demo/Makefile).
infra/demo/kubeconfig
# Ad-hoc TLS material from browser-trust/mkcert work — certs, and
# especially private keys, never committed regardless of where they land.
*.crt
*.pem
*.key
# Ad-hoc debugging output (kubectl/flux/docker logs redirected to a file)
# — never meant to be committed, easy to forget mid-troubleshooting.
*.log
# Terraform local state/plugin cache/plan output (infra/gcp) — state lives in
# GCS backends, never locally; .terraform.lock.hcl IS committed (it's not
# matched by this) since it pins provider versions per root.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log